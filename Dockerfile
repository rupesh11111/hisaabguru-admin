# Multi-stage production build for the hisaabGuru admin panel (Next.js).
# Final image is a slim Alpine Node 24 carrying only the standalone server
# output — no source, no dev deps, no full node_modules tree.
#
# Node 24 (not 22, as the backend uses): package-lock.json is generated by
# npm 11, and the npm 10 that ships with node:22-alpine rejects it — it reads
# @emnapi/* optional peers as "Missing from lock file" and fails `npm ci`.

# ---------- Dependencies ----------
FROM node:24-alpine AS deps

WORKDIR /app

# Cached layer: only re-runs when the lockfile changes.
COPY package.json package-lock.json ./
RUN npm ci


# ---------- Builder ----------
FROM node:24-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, not
# read at runtime. Setting this only as a deploy variable would silently ship a
# bundle still pointing at the localhost fallback in src/lib/api.ts, so it has
# to arrive as a build arg.
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_TELEMETRY_DISABLED=1

RUN npm run build


# ---------- Runtime ----------
FROM node:24-alpine AS runtime

WORKDIR /app

# Non-root user for safety
RUN addgroup -S app && adduser -S app -G app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3100
# Next's standalone server binds 'localhost' by default, which is unreachable
# from outside the container.
ENV HOSTNAME=0.0.0.0

# standalone/ holds server.js and the traced deps; static/ is not included in it
# and must be copied separately or every asset 404s. (No public/ dir in this
# project — add a COPY for it if one is ever introduced.)
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static

USER app

EXPOSE 3100

# 127.0.0.1, not localhost: busybox resolves localhost to [::1] first, and the
# server binds IPv4 only (HOSTNAME=0.0.0.0), so the probe would be refused and
# the container would sit permanently unhealthy while serving traffic fine.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3100/api/health || exit 1

CMD ["node", "server.js"]
